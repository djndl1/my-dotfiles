{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
	"permission": {
		"edit": "ask",
		"bash": "ask"
	},
	"provider": {
		"my-deepseek": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Custom DeepSeek",
			"options": {
				"baseURL": "https://ai.cisdi.com.cn/api/"
			},
			"models": {
				"glm-5.1-fp8": {
					"name": "GLM-5.1"
				}
			}
		},
	},
	"mcp": {
  	  "context7": {
  	    "type": "remote",
  	    "url": "https://mcp.context7.com/mcp",
  	    "enabled": true,
  	    "headers": {
  	      "CONTEXT7_API_KEY": "ctx7sk-91b2b1f5-b1dc-43bb-82e7-d2b1d4fca465"
  	    }
  	  }
	},
  "plugin": [ 
	  "@angdrew/opencode-hashline-plugin",
	  "@tarquinen/opencode-dcp@latest",
	  "@upstash/context7-mcp"
  ]
}
