{
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": true,
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "external_directory": "ask",
    "bash": {
      "*": "ask",
      "rm -rf *": "deny",
      "sudo *": "ask",
      "head *": "allow",
      "tr *": "allow",
      "uniq *": "allow",
      "nl *": "allow",
      "break": "allow",
      "head": "allow",
      "xargs *": "allow",
      "cd *": "allow",
      "cd": "allow",
      "for *": "allow",
      "for": "allow",
      "cat *": "allow",
      "cat": "allow",
      "tail *": "allow",
      "tail": "allow",
      "grep *": "allow",
      "grep": "allow",
      "rg *": "allow",
      "rg": "allow",
      "sed *": "allow",
      "sed": "allow",
      "echo *": "allow",
      "echo": "allow",
      "ls *": "allow",
      "ls": "allow",
      "find *": "allow",
      "find": "allow",
      "sort": "allow",
      "wc": "allow",
      "wc *": "allow",
      "which *": "allow",
      "true": "allow",
      "git diff *": "allow",
      "git -C *": "allow",
      "git status *": "allow",
      "git status": "allow",
      "git show *": "allow",
      "git show": "allow",
      "git log *": "allow",
      "git log": "allow"
    }
  }
}
